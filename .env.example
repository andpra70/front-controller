DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
# Password effettiva del volume Mongo esistente; cambiarla solo dopo una rotazione nel DB.
MONGO_RUNTIME_PASSWORD=rootpass
MINIO_ROOT_USER=vfsadmin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace
# Registrare in Google Cloud sia https://<DOMAIN>/auth/api/callback sia
# https://localhost/auth/api/callback come URI di reindirizzamento autorizzati.
ADMIN_GOOGLE_SUBS=google-sub-id
JWT_ISSUER=vfs-auth
JWT_AUDIENCE=vfs-clients
